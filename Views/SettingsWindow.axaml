<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Babel.Player.ViewModels"
        xmlns:v="using:Babel.Player.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="640"
        x:Class="Babel.Player.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/Icons/app.ico"
        Title="{local:Localize Window_Title_Settings}"
        Width="740" Height="680"
        MinWidth="600" MinHeight="500"
        xmlns:local="using:Babel.Player.Converters">

    <Window.Styles>
        <Style Selector="RadioButton.sidebar-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource StatusTextBrush}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="RadioButton.sidebar-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource PillHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="RadioButton.sidebar-item:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="Border.settings-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        </Style>
    </Window.Styles>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   Classes="text-display" Text="{local:Localize Settings_Title}" 
                   Margin="0,0,0,16"/>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" 
                Background="{DynamicResource SurfaceSubtleBrush}"
                CornerRadius="8"
                Padding="4"
                Margin="0,0,12,0">
            <StackPanel>
                <RadioButton Classes="sidebar-item" GroupName="SettingsNav" Content="{local:Localize Settings_Nav_General}" IsChecked="{Binding IsGeneralSelected, Mode=TwoWay}" Tag="General"/>
                <RadioButton Classes="sidebar-item" GroupName="SettingsNav" Content="{local:Localize Settings_Nav_Hotkeys}" IsChecked="{Binding IsHotkeysSelected, Mode=TwoWay}" Tag="Hotkeys"/>
                <RadioButton Classes="sidebar-item" GroupName="SettingsNav" Content="{local:Localize Settings_Nav_Video}" IsChecked="{Binding IsVideoSelected, Mode=TwoWay}" Tag="Video"/>
                <RadioButton Classes="sidebar-item" GroupName="SettingsNav" Content="{local:Localize Settings_Nav_Models}" IsChecked="{Binding IsModelsSelected, Mode=TwoWay}" Tag="Models"/>
                <RadioButton Classes="sidebar-item" GroupName="SettingsNav" Content="{local:Localize Settings_Nav_About}" IsChecked="{Binding IsAboutSelected, Mode=TwoWay}" Tag="About"/>
                <RadioButton Classes="sidebar-item" GroupName="SettingsNav" Content="{local:Localize Settings_Nav_Diagnostics}" IsChecked="{Binding IsDiagnosticsSelected, Mode=TwoWay}" Tag="Diagnostics"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="1" Grid.Column="1" 
                Background="{DynamicResource PanelBackgroundBrush}"
                CornerRadius="8"
                Padding="20">
            <Grid>
                <!-- General Panel -->
                <ScrollViewer IsVisible="{Binding IsGeneralSelected}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <!-- Session Settings Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Settings_Group_Session}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                                        <TextBlock Text="{local:Localize Settings_Label_RecentLimit}" Classes="text-secondary" Foreground="{DynamicResource StatusTextBrush}"/>
                                        <TextBlock Text="{local:Localize Settings_Hint_RecentLimit}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding MaxRecentSessions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalAlignment="Center"/>
                                </Grid>
                                <CheckBox IsChecked="{Binding AutoSaveEnabled}" Content="{local:Localize Settings_Check_AutoSave}"/>
                                <CheckBox IsChecked="{Binding StoreProjectsNextToMedia}" Content="{local:Localize Settings_Check_StoreProjectsNextToMedia}"/>
                                <TextBlock Text="{local:Localize Settings_Hint_StoreProjectsNextToMedia}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- App Language Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{local:Localize Settings_Group_AppLanguage}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <ComboBox ItemsSource="{Binding AppLanguageOptions}"
                                          SelectedItem="{Binding SelectedAppLanguage, Mode=TwoWay}"
                                          Width="260"
                                          HorizontalAlignment="Left">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettingsViewModel+AppLanguageOption">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{local:Localize Settings_Hint_AppLanguage}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-card">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{local:Localize Settings_Group_Layout}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <CheckBox IsChecked="{Binding ShowPipelinePane, Mode=TwoWay}"
                                          Content="{local:Localize Settings_Check_ShowPipelinePane}"/>
                                <CheckBox IsChecked="{Binding ShowSegmentsPane, Mode=TwoWay}"
                                          Content="{local:Localize Settings_Check_ShowSegmentsPane}"/>
                                <TextBlock Text="{local:Localize Settings_Hint_PaneVisibility}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                <CheckBox IsChecked="{Binding SwapPaneSides, Mode=TwoWay}"
                                          Content="{local:Localize Settings_Check_SwapPaneSides}"/>
                                <TextBlock Text="{local:Localize Settings_Hint_SwapPaneSides}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                <TextBlock Text="{local:Localize Settings_Hint_PaneResize}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- GPU Backend Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Settings_Group_Gpu}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{local:Localize Settings_Label_PreferredGpu}" Classes="text-secondary" Foreground="{DynamicResource StatusTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding GpuBackendOptions}"
                                              SelectedItem="{Binding PreferredLocalGpuBackend, Mode=TwoWay}"
                                              Width="220"
                                              HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource GpuHostBackendDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{local:Localize Settings_Hint_Gpu}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Backend Status Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Settings_Group_BackendStatus}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                                    <Ellipse Width="10" Height="10" Fill="{Binding BackendStatusBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding BackendStatusText}" Classes="text-emphasis" TextWrapping="Wrap" MaxWidth="480"/>
                                    <Button Content="{local:Localize Common_Restart}" Command="{Binding RestartBackendCommand}" IsEnabled="{Binding CanRestartBackend}" Padding="12,6" VerticalAlignment="Top"/>
                                </StackPanel>
                                <TextBlock Text="{Binding BackendErrorDetail}" IsVisible="{Binding BackendErrorDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="text-caption" Foreground="{DynamicResource SystemErrorForeground}" Opacity="0.8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Docker GPU Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Settings_Group_DockerGpu}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{local:Localize Settings_Label_AdvancedGpuUrl}" Classes="text-secondary" Foreground="{DynamicResource StatusTextBrush}"/>
                                    <TextBox Text="{Binding AdvancedGpuServiceUrl, Mode=TwoWay}" IsEnabled="{Binding IsDockerBackend}" Width="280" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{local:Localize Settings_Hint_AdvancedGpuUrl}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding AlwaysStartLocalGpuRuntimeAtAppStart}" Content="{local:Localize Settings_Check_AlwaysStartGpu}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{local:Localize Settings_Group_PipelineAudio}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{local:Localize Settings_Hint_PipelineAudio}" Classes="text-caption" Opacity="0.65" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Advanced CPU Expander -->
                        <Expander Header="{local:Localize Settings_Expander_AdvancedCpu}" IsExpanded="False">
                            <StackPanel Spacing="12" Margin="0,12,0,0">
                                <TextBlock Text="{local:Localize Settings_Hint_AdvancedCpu}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CpuAdvancedSettingsNotice}" Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{local:Localize Settings_Label_CpuComputeType}" VerticalAlignment="Center" Classes="text-secondary"/>
                                    <ComboBox Grid.Column="1" Grid.Row="0" ItemsSource="{Binding TranscriptionCpuComputeTypeOptions}" SelectedItem="{Binding TranscriptionCpuComputeType, Mode=TwoWay}" Width="150"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{local:Localize Settings_Label_CpuThreads}" VerticalAlignment="Center" Classes="text-secondary" Margin="0,8,0,0"/>
                                    <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding TranscriptionCpuThreads, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,8,0,0"/>
                                    <CheckBox Grid.Column="1" Grid.Row="2" Content="{local:Localize Settings_Check_AutoWorkers}" IsChecked="{Binding TranscriptionNumWorkersUseAuto, Mode=TwoWay}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Text="{local:Localize Settings_Label_WorkersManual}" VerticalAlignment="Center" Classes="text-secondary" Margin="0,8,0,0"/>
                                    <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding TranscriptionNumWorkers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,8,0,0" IsEnabled="{Binding TranscriptionNumWorkersManualEnabled}"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Hotkeys Panel -->
                <ScrollViewer IsVisible="{Binding IsHotkeysSelected}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Settings_Group_Hotkeys}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{local:Localize Settings_Hint_Hotkeys}" Classes="text-caption" Opacity="0.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{local:Localize Settings_Label_PlayPauseHotkey}" VerticalAlignment="Center" Classes="text-secondary"/>
                                    <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding PlayPauseHotkey}" IsReadOnly="True" Width="120"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{local:Localize Settings_Label_ToggleLeftPaneHotkey}" VerticalAlignment="Center" Classes="text-secondary" Margin="0,8,0,0"/>
                                    <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding ToggleLeftPaneHotkey}" IsReadOnly="True" Width="120" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="{local:Localize Settings_Label_ToggleRightPaneHotkey}" VerticalAlignment="Center" Classes="text-secondary" Margin="0,8,0,0"/>
                                    <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding ToggleRightPaneHotkey}" IsReadOnly="True" Width="120" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Text="{local:Localize Settings_Label_ToggleDubHotkey}" VerticalAlignment="Center" Classes="text-secondary" Margin="0,8,0,0"/>
                                    <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding ToggleDubModeHotkey}" IsReadOnly="True" Width="120" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="4" Text="{local:Localize Settings_Label_ToggleFullscreenHotkey}" VerticalAlignment="Center" Classes="text-secondary" Margin="0,8,0,0"/>
                                    <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding ToggleFullscreenHotkey}" IsReadOnly="True" Width="120" Margin="0,8,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Video Panel -->
                <ScrollViewer IsVisible="{Binding IsVideoSelected}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <!-- Playback / captions -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Settings_Group_EmbeddedPlayback}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <CheckBox IsChecked="{Binding BilingualSubtitlesEnabled, Mode=TwoWay}"
                                          Content="{local:Localize Settings_Check_BilingualSubs}"/>
                                <TextBlock Text="{local:Localize Settings_Hint_BilingualSubs}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Hardware Decode Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Settings_Group_HardwareDecode}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{local:Localize Settings_Label_HardwareDecoder}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Grid.Row="0" ItemsSource="{Binding HwdecOptions}" SelectedItem="{Binding VideoHwdec, Mode=TwoWay}" Width="200"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{local:Localize Settings_Label_GpuRenderApi}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <ComboBox Grid.Column="1" Grid.Row="1" ItemsSource="{Binding GpuApiOptions}" SelectedItem="{Binding VideoGpuApi, Mode=TwoWay}" Width="200" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="{local:Localize Settings_Label_ExportEncoder}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <ComboBox Grid.Column="1" Grid.Row="2" ItemsSource="{Binding ExportEncoderOptions}" SelectedItem="{Binding VideoExportEncoder, Mode=TwoWay}" Width="200" Margin="0,8,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- GPU-Next Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Settings_Group_GpuNext}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <CheckBox IsChecked="{Binding VideoUseGpuNext, Mode=TwoWay}" Content="{local:Localize Settings_Check_UseGpuNext}"/>
                                <TextBlock Text="{local:Localize Settings_Hint_GpuNext}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- RTX Video Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Settings_Group_RtxVideo}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <CheckBox IsChecked="{Binding VideoVsrEnabled, Mode=TwoWay}" IsEnabled="{Binding VsrSettingsAvailable}" Content="{local:Localize Settings_Check_Vsr}"/>
                                <TextBlock Text="{local:Localize Settings_Hint_Vsr}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RtxVideoHardwareGateHint}" IsVisible="{Binding HasRtxVideoHardwareGateHint}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{local:Localize Settings_Label_VsrSupport}" Classes="text-label"/>
                                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding VsrSupportHintText}" Classes="text-caption" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="0" Grid.Row="1" Text="{local:Localize Settings_Label_VsrRequested}" Classes="text-label"/>
                                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding VsrRequestedStateText}" Classes="text-caption" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="0" Grid.Row="2" Text="{local:Localize Settings_Label_VsrResolved}" Classes="text-label"/>
                                        <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding VsrResolvedStateText}" Classes="text-caption" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="0" Grid.Row="3" Text="{local:Localize Settings_Label_VsrReason}" Classes="text-label"/>
                                        <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding VsrReasonText}" Classes="text-caption" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="0" Grid.Row="4" Text="{local:Localize Settings_Label_VsrFilter}" Classes="text-label"/>
                                        <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding VsrFilterText}" Classes="text-caption" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- HDR Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Settings_Group_Hdr}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{local:Localize Settings_Hint_Hdr}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <RadioButton GroupName="VideoHdrPlaybackMode" Content="{local:Localize Option_Off}" IsChecked="{Binding IsHdrModeOff, Mode=TwoWay}" IsEnabled="{Binding VideoUseGpuNext}" Padding="12,8"/>
                                    <RadioButton GroupName="VideoHdrPlaybackMode" Content="{local:Localize Settings_Radio_HdrRtx}" IsChecked="{Binding IsHdrModeNvidia, Mode=TwoWay}" IsEnabled="{Binding RtxHdrDriverModeAvailable}" Padding="12,8"/>
                                    <RadioButton GroupName="VideoHdrPlaybackMode" Content="{local:Localize Settings_Radio_HdrPassthrough}" IsChecked="{Binding IsHdrModeMpv, Mode=TwoWay}" IsEnabled="{Binding HdrSettingsAvailable}" Padding="12,8"/>
                                </StackPanel>
                                
                                <StackPanel IsVisible="{Binding IsMpvHdrPassthroughDetailsVisible}" Spacing="8" Margin="0,8,0,0">
                                    <TextBlock Text="{local:Localize Settings_Label_MpvPassthrough}" Classes="text-label"/>
                                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{local:Localize Settings_Label_ToneMapping}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Grid.Row="0" ItemsSource="{Binding HdrToneMappingOptions}" SelectedItem="{Binding VideoToneMapping, Mode=TwoWay}" Width="200" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="0" Grid.Row="1" Text="{local:Localize Settings_Label_TargetPeak}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding VideoTargetPeak, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" PlaceholderText="{local:Localize Settings_Placeholder_TargetPeak}" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Column="0" Grid.Row="2" Text="{local:Localize Settings_Label_HdrComputePeak}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <CheckBox Grid.Column="1" Grid.Row="2" IsChecked="{Binding VideoHdrComputePeak, Mode=TwoWay}" Content="{local:Localize Settings_Check_HdrComputePeak}" Margin="0,8,0,0"/>
                                    </Grid>
                                </StackPanel>
                                
                                <TextBlock Text="{Binding HdrAvailabilityHintText}" IsVisible="{Binding HasHdrAvailabilityHint}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Static vm:SettingsViewModel.HdrDriverFeatureHintText}" Classes="text-micro" Opacity="0.4" TextWrapping="Wrap"/>
                                <TextBlock Text="{local:Localize Settings_Hint_VideoRestart}" Classes="text-micro" Opacity="0.4" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Models Panel -->
                <Grid IsVisible="{Binding IsModelsSelected}" RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{local:Localize Settings_Nav_Models}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{local:Localize Settings_Hint_Models}" Classes="text-caption" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ModelsTab.Models}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModelDownloadEntry">
                                    <Border Margin="0,0,0,8" Padding="12" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="8">
                                        <Grid ColumnDefinitions="160,*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding ProviderLabel}" Classes="text-micro" Opacity="0.5"/>
                                                <TextBlock Text="{Binding ModelId}" Classes="text-emphasis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="12,0">
                                                <TextBlock Text="{Binding StatusLabel}" Classes="text-caption"/>
                                                <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="1" Height="4" IsVisible="{Binding IsProgressVisible}" AutomationProperties.Name="{Binding ModelId, StringFormat='Download progress for {0}'}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="{local:Localize Common_Download}" IsVisible="{Binding CanDownload}" Command="{Binding DownloadCommand}" Padding="10,6"/>
                                                <Button Content="{local:Localize Common_Cancel}" IsVisible="{Binding CanCancel}" Command="{Binding CancelCommand}" Padding="10,6"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- About Panel -->
                <ScrollViewer IsVisible="{Binding IsAboutSelected}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="{local:Localize Window_Title_Main}" Classes="text-display" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AppVersion}" HorizontalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="{Binding AppBuildDate}" Classes="text-caption" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="{local:Localize Settings_About_License}" Classes="text-micro" HorizontalAlignment="Center" Opacity="0.5"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="12" Margin="0,20,0,0">
                            <TextBlock Text="{local:Localize Settings_About_Support}" Classes="text-secondary" HorizontalAlignment="Center" Opacity="0.7"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <Button Command="{Binding OpenKofiCommand}" Padding="16,10" Background="{DynamicResource ButtonBackgroundBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="☕" FontSize="16"/>
                                        <TextBlock Text="{local:Localize Settings_About_Kofi}" Classes="text-emphasis"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenGitHubSponsorsCommand}" Padding="16,10" Background="{DynamicResource ButtonBackgroundBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="❤" FontSize="16" Foreground="#BF3989"/>
                                        <TextBlock Text="{local:Localize Settings_About_GitHubSponsors}" Classes="text-emphasis"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Diagnostics Panel -->
                <ScrollViewer IsVisible="{Binding IsDiagnosticsSelected}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Diag_HardwareSnapshot}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{local:Localize Diag_Cpu}" Opacity="0.65"/>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CpuInfo}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{local:Localize Diag_Gpu}" Opacity="0.65" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding GpuInfo}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="{local:Localize Diag_Ram}" Opacity="0.65" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding RamInfo}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Diag_RuntimeRouting}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{local:Localize Diag_InferenceHost}" Opacity="0.65"/>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding InferenceModeInfo}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{local:Localize Diag_WarmupStatus}" Opacity="0.65" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding RuntimeWarmupInfo}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="{local:Localize Diag_NmtFallback}" Opacity="0.65" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding TranslationFallbackInfo}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Text="{local:Localize Diag_GpuProbeStreak}" Opacity="0.65" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding GpuHostProbeDiagnostics}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{local:Localize Diag_Environment}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="{local:Localize Diag_PythonPath}" Opacity="0.65"/>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding PythonInfo}" TextWrapping="Wrap" Classes="text-caption"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{local:Localize Diag_FfmpegPath}" Opacity="0.65" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding FfmpegInfo}" TextWrapping="Wrap" Classes="text-caption" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <Button Content="{local:Localize Diag_Button_Refresh}" Command="{Binding RefreshDiagnosticsCommand}" HorizontalAlignment="Left" Padding="12,8"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Right" 
                    Spacing="10" Margin="0,16,0,0">
            <Button Content="{local:Localize Common_Cancel}" Click="OnCancelClick" Padding="16,8"/>
            <Button Content="{local:Localize Settings_Button_SaveClose}" Click="OnOKClick" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Babel.Player.ViewModels"
        xmlns:v="using:Babel.Player.Views"
        xmlns:bp="using:Babel.Player"
        xmlns:models="using:Babel.Player.Models"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="700"
        x:Class="Babel.Player.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Icons/app.ico"
        Width="1280" Height="700"
        MinWidth="960" MinHeight="520"
        CanResize="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource IndustrialBackgroundBrush}"
        xmlns:local="using:Babel.Player.Converters">
    <Window.Styles>
        <Style Selector="Border.top-chrome">
            <Setter Property="Height" Value="32" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border.top-chrome.fullscreen-hidden">
            <Setter Property="Height" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-8" />
        </Style>

        <Style Selector="Border.pane-splitter">
            <Setter Property="Width" Value="5" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.pane-splitter:pointerover">
            <Setter Property="Background" Value="#182033" />
        </Style>
        <Style Selector="Border.video-empty-state">
            <Setter Property="Background" Value="#F4000000" />
        </Style>
        <Style Selector="Border.video-empty-state.media-loaded">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Styles>

    <!-- Borderless window: OS resize hit-targets at edges/corners (client content reflows via inner * grid columns). -->
    <Grid RowDefinitions="6,*,6" ColumnDefinitions="6,*,6" PointerMoved="OnWindowSurfacePointerMoved">
        <Panel Grid.Row="0" Grid.Column="0"
               Width="6" Height="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeNW" />
        <Panel Grid.Row="0" Grid.Column="1"
               Height="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeN" />
        <Panel Grid.Row="0" Grid.Column="2"
               Width="6" Height="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeNE" />

        <Panel Grid.Row="1" Grid.Column="0"
               Width="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeW" />
        <Panel Grid.Row="1" Grid.Column="2"
               Width="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeE" />

        <Panel Grid.Row="2" Grid.Column="0"
               Width="6" Height="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeSW" />
        <Panel Grid.Row="2" Grid.Column="1"
               Height="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeS" />
        <Panel Grid.Row="2" Grid.Column="2"
               Width="6" Height="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeSE" />

    <Grid Grid.Row="1" Grid.Column="1" x:Name="PaneLayoutHost" RowDefinitions="Auto,*" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <Border Grid.Row="0"
                Classes="top-chrome"
                Classes.fullscreen-hidden="{Binding Playback.Preview.IsFullscreen}"
                Grid.ColumnSpan="5"
                Background="{DynamicResource SurfaceSubtleBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,0,0,0"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Classes="text-title"
                           Text="{local:Localize Window_Title_Main}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />
                <!-- Win11-style: zero gap, square targets, flush to the right window edge (no right padding on chrome Border). -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="0"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Right"
                            UseLayoutRounding="True">
                    <Button Classes="chrome-button"
                            Width="32"
                            Height="32"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Click="OnMinimizeWindowClick"
                            AutomationProperties.Name="{local:Localize Chrome_Minimize}">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Border Canvas.Left="4"
                                        Canvas.Top="11"
                                        Width="16"
                                        Height="2.5"
                                        Background="{DynamicResource PrimaryTextBrush}"
                                        CornerRadius="1" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="chrome-button"
                            Width="32"
                            Height="32"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Click="OnToggleMaximizeWindowClick"
                            AutomationProperties.Name="{local:Localize Chrome_MaximizeRestore}">
                        <Grid Width="24" Height="24">
                            <Viewbox x:Name="ChromeMaximizeIcon"
                                     Width="14"
                                     Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="5.5"
                                               Canvas.Top="5.5"
                                               Width="13"
                                               Height="13"
                                               Stroke="{DynamicResource PrimaryTextBrush}"
                                               StrokeThickness="1.75"
                                               Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                            <Viewbox x:Name="ChromeRestoreIcon"
                                     Width="14"
                                     Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="False">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="9"
                                               Canvas.Top="5"
                                               Width="9"
                                               Height="9"
                                               Stroke="{DynamicResource PrimaryTextBrush}"
                                               StrokeThickness="1.75"
                                               Fill="Transparent" />
                                    <Rectangle Canvas.Left="5"
                                               Canvas.Top="9"
                                               Width="9"
                                               Height="9"
                                               Stroke="{DynamicResource PrimaryTextBrush}"
                                               StrokeThickness="1.75"
                                               Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Button>
                    <Button Classes="chrome-button chrome-close"
                            Width="32"
                            Height="32"
                            Background="{DynamicResource DestructiveBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Click="OnCloseWindowClick"
                            AutomationProperties.Name="{local:Localize Chrome_Close}">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.75"
                                      StrokeLineCap="Round"
                                      Stretch="None"
                                      Data="M 6.5,6.5 L 17.5,17.5 M 17.5,6.5 L 6.5,17.5" />
                            </Canvas>
                        </Viewbox>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{local:Localize Common_Close}"
                                          Click="OnCloseWindowClick" />
                                <MenuItem Header="{local:Localize Menu_File_ForceClose}"
                                          IsVisible="{x:Static bp:BuildInfo.IsDevBuild}"
                                          Click="OnForceCloseWindowClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             LEFT PANEL: Pipeline
             ═══════════════════════════════════════════════════ -->
<Border Grid.Row="1"
        Grid.Column="{Binding Playback.Preview.PipelinePaneColumn}"
        Width="{Binding Playback.Preview.PipelinePaneWidth}"
        IsVisible="{Binding Playback.Preview.IsPipelinePaneShown}"
        Classes="glass-rack"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="{Binding Playback.Preview.PipelinePaneBorderThickness}"
        Margin="{Binding Playback.Preview.PipelinePaneMargin}">
    <Border.Resources>
        <!-- Shadow the Application ThemeDictionary for all panel descendants.
             These values apply in both Light and Dark mode — the panel is always dark. -->
        <SolidColorBrush x:Key="PrimaryTextBrush"        Color="#E0DEFF" />
        <SolidColorBrush x:Key="StatusTextBrush"         Color="#8A88A8" />
        <SolidColorBrush x:Key="ControlBackgroundBrush"  Color="#1E1E2E" />
        <SolidColorBrush x:Key="ButtonBackgroundBrush"   Color="#2A2A3A" />
        <SolidColorBrush x:Key="BorderBrush"        Color="#2E2E44" />
        <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="#2A2A3A" />
    </Border.Resources>
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
<Border Grid.Row="0" Padding="16,14,16,12"
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="{local:Localize Section_Pipeline}" Classes="text-display"
                    Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Classes="console-button"
                Command="{Binding Playback.Pipeline.ClearPipelineCommand}"
                ToolTip.Tip="{local:Localize Tooltip_ClearPipeline}">
            <TextBlock Text="{local:Localize Common_Clear}"/>
        </Button>
    </Grid>
</Border>

                <!-- Scrollable body with sticky footer overlay -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,16,16,0" Spacing="20">

                        <!-- TARGET LANGUAGE -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="{local:Localize Section_TargetLanguage}" Classes="text-overline"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="{local:Localize Label_Output}" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.TargetLanguageOptions}"
                                          SelectedItem="{Binding Playback.SelectedTargetLanguageOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- AUDIO + DUB (session pipeline) -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="{local:Localize Section_AudioAndDub}" Classes="text-overline"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <CheckBox IsChecked="{Binding Playback.VocalSeparationEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding Playback.VocalSeparationAvailable}"
                                      Content="{local:Localize Label_SeparateVocals}" />
                            <TextBlock Text="{Binding Playback.VocalSeparationAvailabilityHint}"
                                       IsVisible="{Binding Playback.HasVocalSeparationAvailabilityHint}"
                                       FontSize="10" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- TRANSCRIPTION -->
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="{local:Localize Section_Transcription}" Classes="text-overline"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Command="{Binding Playback.Pipeline.RefreshTranscriptionCommand}"
                                        IsEnabled="{Binding Playback.Pipeline.CanRefreshTranscription}"
                                        Background="Transparent" Padding="6,2"
                                        Foreground="{DynamicResource StatusTextBrush}"
                                        ToolTip.Tip="{local:Localize Tooltip_RerunTranscription}"
                                        AutomationProperties.Name="{local:Localize Automation_RerunTranscription}">
                                    <TextBlock Text="↻" FontSize="16" />
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </Grid>

                             <StackPanel Spacing="5">
                                 <TextBlock Text="{local:Localize Label_Compute}" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
<ComboBox ItemsSource="{Binding Playback.InferenceRuntimeOptions}"
                                           SelectedItem="{Binding Playback.TranscriptionRuntime, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch"
                                           Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ComputeProfileDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                             <StackPanel Spacing="5">
                                 <TextBlock Text="{local:Localize Label_Provider}" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                 <ComboBox ItemsSource="{Binding Playback.TranscriptionProviders}"
                                           SelectedItem="{Binding Playback.TranscriptionProvider, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch"
                                           Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}" />
                            </StackPanel>

<StackPanel Spacing="5">
                                 <TextBlock Text="{local:Localize Label_Model}" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
<ComboBox ItemsSource="{Binding Playback.AvailableTranscriptionModels}"
                                            SelectedItem="{Binding Playback.SelectedTranscriptionModel, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch"
                                           Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding ModelId}"/>
                                                 <TextBlock Text="{local:Localize Status_NeedsDownload}" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsDownloadVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                                 <TextBlock Text="{local:Localize Status_Ready}" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsReadyVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="{local:Localize Label_SpokenLanguage}" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.SpokenLanguageOptions}"
                                          SelectedItem="{Binding Playback.SelectedSpokenLanguageOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Text="{Binding Playback.TranscriptionKeyStatus}"
                                        Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}"
                                        IsVisible="{Binding Playback.TranscriptionKeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- DIARIZATION / SPEAKERS -->
                        <StackPanel Spacing="10">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="{local:Localize Section_Diarization}" Classes="text-overline"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding Playback.Pipeline.RefreshDiarizationCommand}"
                                            IsEnabled="{Binding Playback.Pipeline.CanRefreshDiarization}"
                                            Background="Transparent" Padding="6,2"
                                            Foreground="{DynamicResource StatusTextBrush}"
                                            ToolTip.Tip="{local:Localize Tooltip_RerunDiarization}"
                                            AutomationProperties.Name="{local:Localize Automation_RerunDiarization}">
                                        <TextBlock Text="↻" FontSize="16" />
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{local:Localize Label_MultiSpeakerAudio}" Classes="text-secondary"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{local:Localize Hint_MultiSpeakerAudio}" />
                                <CheckBox Content="{local:Localize Check_DetectSpeakers}"
                                          FontSize="12"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          IsChecked="{Binding Playback.SpeakerRouting.DetectMultipleSpeakers, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Status -->
                            <TextBlock Text="{Binding Playback.SpeakerRouting.AutoSpeakerDetectionStatus}"
                                       FontSize="11"
                                       Foreground="{DynamicResource StatusTextBrush}"
                                       IsVisible="{Binding Playback.SpeakerRouting.HasAutoSpeakerDetectionStatus}"
                                       TextWrapping="Wrap" />

                            <!-- Per-speaker voice / reference clip assignment -->
                            <StackPanel Spacing="5">

                                <!-- Hint shown when no speaker IDs have been detected yet -->
                                <TextBlock Text="{local:Localize Hint_EnableMultiSpeakerForIds}"
                                           Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap"
                                           IsVisible="{Binding Playback.SpeakerRouting.IsMultiSpeakerNoSpeakersYet}" />

                                <TextBlock Text="{local:Localize Hint_SpeakerAssignmentsInWizard}"
                                           FontSize="11"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           TextWrapping="Wrap" />

                               <Button IsEnabled="{Binding Playback.SpeakerRouting.CanOpenSpeakerSetupWizard}"
                                       HorizontalAlignment="Stretch"
                                       Classes="console-button"
                                       Click="OnReviewSpeakerReferencesClick"
                                       ToolTip.Tip="{local:Localize Tooltip_OpenSpeakerWizard}"
                                       Content="{local:Localize Button_SpeakerSetupWizard}" />

                           </StackPanel>

                       </StackPanel>

                        <!-- TRANSLATION -->
                        <StackPanel Spacing="10">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="{local:Localize Section_Translation}" Classes="text-overline"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding Playback.Pipeline.RefreshTranslationCommand}"
                                            IsEnabled="{Binding Playback.Pipeline.CanRefreshTranslation}"
                                            Background="Transparent" Padding="6,2"
                                            Foreground="{DynamicResource StatusTextBrush}"
                                            ToolTip.Tip="{local:Localize Tooltip_RerunTranslation}"
                                            AutomationProperties.Name="{local:Localize Automation_RerunTranslation}">
                                        <TextBlock Text="↻" FontSize="16" />
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="5">
                                <TextBlock Text="{local:Localize Label_Compute}" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.InferenceRuntimeOptions}"
                                          SelectedItem="{Binding Playback.TranslationRuntime, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ComputeProfileDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="{local:Localize Label_Provider}" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.TranslationProviders}"
                                          SelectedItem="{Binding Playback.TranslationProvider, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="{local:Localize Label_Model}" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.AvailableTranslationModels}"
                                          SelectedItem="{Binding Playback.SelectedTranslationModel, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding ModelId}"/>
                                                <TextBlock Text="{local:Localize Status_NeedsDownload}" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsDownloadVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Text="{local:Localize Status_Ready}" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsReadyVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- DUB -->
                        <StackPanel Spacing="10">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="{local:Localize Section_Dub}" Classes="text-overline"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding Playback.Pipeline.RefreshDubCommand}"
                                            IsEnabled="{Binding Playback.Pipeline.CanRefreshDub}"
                                            Background="Transparent" Padding="6,2"
                                            Foreground="{DynamicResource StatusTextBrush}"
                                            ToolTip.Tip="{local:Localize Tooltip_RerunDub}"
                                            AutomationProperties.Name="{local:Localize Automation_RerunDub}">
                                        <TextBlock Text="↻" FontSize="16" />
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="5">
                                <TextBlock Text="{local:Localize Label_Compute}" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.InferenceRuntimeOptions}"
                                          SelectedItem="{Binding Playback.TtsRuntime, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ComputeProfileDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="{local:Localize Label_Provider}" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.TtsProviders}"
                                          SelectedItem="{Binding Playback.TtsProvider, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" />
                                <CheckBox Content="{local:Localize Check_ChatterboxCloneConsent}"
                                          IsChecked="{Binding Playback.ChatterboxVoiceCloneConsent, Mode=TwoWay}"
                                          IsVisible="{Binding Playback.IsChatterboxTtsSelected}"
                                          FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding Playback.ShowTtsAssignmentModeSwitch}">
                                <TextBlock Text="{local:Localize Label_VoiceAssignment}" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <CheckBox Content="{local:Localize Check_AssignPerSpeakerInWizard}"
                                          IsChecked="{Binding Playback.TtsVoiceUsePerSpeakerWizard, Mode=TwoWay}"
                                          FontSize="12" />
                                <TextBlock Text="{local:Localize Hint_VoiceAssignment}"
                                           FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                           IsVisible="{Binding Playback.ShowPerSpeakerVoiceHint}" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding Playback.TtsVoiceComboHeaderText}" />
                                <ComboBox ItemsSource="{Binding Playback.AvailableTtsOptions}"
                                          SelectedItem="{Binding Playback.SelectedTtsOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding ModelId}"/>
                                                <TextBlock Text="{local:Localize Status_NeedsDownload}" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsDownloadVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Text="{local:Localize Status_Ready}" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsReadyVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Text="{Binding Playback.TtsKeyStatus}"
                                       Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}"
                                       IsVisible="{Binding Playback.TtsKeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                         <!-- API KEYS -->
                         <StackPanel Spacing="8">
                             <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                 <TextBlock Text="{local:Localize Section_ApiKeys}" Classes="text-overline"
                                            Foreground="{DynamicResource PrimaryTextBrush}" />
                             </Border>

                             <TextBlock Text="{local:Localize Hint_ConfigureCredentials}"
                                        FontSize="11"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        TextWrapping="Wrap" />

                              <Button HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center"
                                      Padding="12,10"
                                      FontSize="12"
                                      Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      CornerRadius="6"
                                      Click="OnApiKeysClick">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                      <TextBlock Text="{local:Localize Window_Title_ApiKeys}" VerticalAlignment="Center" FontWeight="Medium"/>
                                  </StackPanel>
                              </Button>
                        </StackPanel>

                         <!-- LANGUAGE ROUTING -->
                         <StackPanel Spacing="10">
                             <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                 <TextBlock Text="{local:Localize Section_LanguageRouting}" Classes="text-overline"
                                            Foreground="{DynamicResource PrimaryTextBrush}" />
                             </Border>

                             <Grid ColumnDefinitions="*,Auto">
                                 <TextBlock Grid.Column="0" Text="{local:Localize Label_SourceAudio}" Classes="text-secondary"
                                            Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                 <Border Grid.Column="1" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"
                                         Padding="8,4">
                                     <TextBlock Text="{Binding Coordinator.CurrentSession.SourceLanguage, TargetNullValue='—'}"
                                                Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                 </Border>
                             </Grid>

                             <Grid ColumnDefinitions="*,Auto">
                                 <TextBlock Grid.Column="0" Text="{local:Localize Label_TargetSubDub}" Classes="text-secondary"
                                            Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                 <Border Grid.Column="1" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"
                                         Padding="8,4">
                                     <TextBlock Text="{Binding Coordinator.CurrentSession.TargetLanguage, TargetNullValue='—'}"
                                                Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                 </Border>
                             </Grid>
                        </StackPanel>

                        <!-- ACTIVE CONFIGURATION -->
                        <StackPanel Spacing="8">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <TextBlock Text="{local:Localize Section_ActiveConfig}" Classes="text-overline"
                                            Foreground="{DynamicResource PrimaryTextBrush}" />
                            </Border>

                            <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Localize Label_ActiveAsr}"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Playback.ActiveTranscriptionConfigLine}"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Localize Label_ActiveCpu}"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Playback.ActiveCpuTuningLine}"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Localize Label_ActiveGpu}"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding Playback.HwGpuLine}"
                                           Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{local:Localize Label_ActiveNmt}"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding Playback.ActiveTranslationConfigLine}"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{local:Localize Label_ActiveTts}"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{Binding Playback.HwNpuLine}"
                                           Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{local:Localize Label_ActiveRam}"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Text="{Binding Playback.HwRamLine}"
                                           Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <!-- PROVIDER DIAGNOSTICS -->
                        <StackPanel Spacing="8">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <TextBlock Text="{local:Localize Section_ProviderDiagnostics}" Classes="text-overline"
                                            Foreground="{DynamicResource PrimaryTextBrush}" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding Playback.ProviderHealthSnapshots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProviderHealthSnapshot">
                                        <Border Padding="10,8"
                                                Background="{DynamicResource ControlBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,6">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Section}"
                                                               Classes="text-secondary"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding StatusLine}"
                                                               Classes="text-caption"
                                                               Foreground="{DynamicResource StatusTextBrush}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>

                                                <TextBlock Text="{Binding SelectionLabel}"
                                                           Classes="text-caption"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Classes="text-caption"
                                                           Foreground="{DynamicResource StatusTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding HostState}"
                                                           Classes="text-caption"
                                                           Foreground="{DynamicResource StatusTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MetricsText}"
                                                           Classes="text-micro"
                                                           Foreground="{DynamicResource StatusTextBrush}"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding MetricsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding CheckedAtText}"
                                                               Classes="text-micro"
                                                               Foreground="{DynamicResource StatusTextBrush}" />
                                                    <TextBlock Text="{local:Localize Status_Stale}"
                                                               Classes="text-micro"
                                                               Foreground="{DynamicResource StatusTextBrush}"
                                                               IsVisible="{Binding IsStale}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Height="260"
                                Background="Transparent"
                                IsHitTestVisible="False" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border VerticalAlignment="Bottom"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,14,16,16">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="6"
                                       IsVisible="{Binding Playback.Pipeline.ShowPipelineStatusChrome}">
                                <TextBlock Text="{Binding Playback.Pipeline.PipelineStageDetail}"
                                           Classes="text-caption"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Playback.Pipeline.PipelineProgressStatusLine}"
                                           Classes="text-micro"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           TextWrapping="Wrap" />
                                <ProgressBar Value="{Binding Playback.Pipeline.PipelineProgressPercent}"
                                             Minimum="0"
                                             Maximum="1"
                                             Classes="neon-pulse"
                                             IsIndeterminate="{Binding Playback.Pipeline.IsPipelineProgressIndeterminate}"
                                             AutomationProperties.Name="{local:Localize Automation_PipelineProgress}" />
                            </StackPanel>

                            <Grid>
                                <Button HorizontalAlignment="Stretch"
                                        Classes="glow-button"
                                        Command="{Binding Playback.Pipeline.RunPipelineCommand}"
                                        IsEnabled="{Binding Playback.Pipeline.CanRunPipeline}"
                                        IsVisible="{Binding !Playback.IsBusy}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Text="▶" VerticalAlignment="Center" />
                                        <TextBlock Text="{local:Localize Button_RunPipeline}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button HorizontalAlignment="Stretch"
                                        Classes="destructive-glow"
                                        Command="{Binding Playback.Pipeline.CancelPipelineCommand}"
                                        IsVisible="{Binding Playback.IsBusy}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <Border Width="12" Height="12" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" CornerRadius="2" VerticalAlignment="Center"/>
                                        <TextBlock Text="{local:Localize Button_CancelPipeline}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Playback.StatusText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxHeight="52" />

                                <Button Grid.Column="1"
                                        Command="{Binding Playback.ShowStatusErrorDetailsCommand}"
                                        IsVisible="{Binding Playback.HasErrorDetails}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Padding="6,2"
                                        MinWidth="24"
                                        FontSize="12"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        CornerRadius="4"
                                        ToolTip.Tip="{local:Localize Tooltip_ExpandErrorDetails}"
                                        AutomationProperties.Name="{local:Localize Automation_ExpandErrorDetails}">
                                    <TextBlock Text="↗" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                x:Name="LeftPaneSplitter"
                Classes="pane-splitter"
                IsVisible="{Binding Playback.Preview.IsLeftPaneVisible}"
                PointerPressed="OnPaneSplitterPointerPressed"
                PointerMoved="OnPaneSplitterPointerMoved"
                PointerReleased="OnPaneSplitterPointerReleased"
                PointerCaptureLost="OnPaneSplitterPointerCaptureLost">
            <Border Width="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource BorderBrush}"
                    Opacity="0.8" />
        </Border>

        <!-- ═══════════════════════════════════════════════════
             PLAYER HOST + chrome
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Grid.Column="2"
              x:Name="PlayerChromeHost"
              RowDefinitions="Auto,*,Auto,Auto"
              Background="{DynamicResource WindowBackgroundBrush}">

            <Grid x:Name="PlayerChromeWidthHost"
                  Grid.Row="0"
                  Grid.RowSpan="4"
                  Grid.Column="0"
                  Background="Transparent"
                  IsHitTestVisible="False" />

            <!-- Diagnostics warning bar (hidden when all deps available) -->
            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource WarningBackgroundBrush}" Padding="10,5"
                    BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="0,0,0,1"
                    IsVisible="{Binding Playback.ShowDiagnosticsWarningBanner}">
                <TextBlock Text="{Binding Playback.DiagnosticsWarningText}"
                                Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}" />
            </Border>

            <!-- Video surface -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Border Background="Black" Margin="0">
                    <v:MpvVideoView x:Name="VideoView" />
                </Border>
                <Border x:Name="VideoEmptyState"
                        Classes="video-empty-state"
                        Classes.media-loaded="{Binding Playback.Preview.IsSourceMediaLoaded}">
                    <Border Padding="28,24"
                            MaxWidth="360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#B0121824"
                            BorderBrush="#663B4558"
                            BorderThickness="1"
                            CornerRadius="18">
                        <StackPanel Spacing="14"
                                    HorizontalAlignment="Center">
                            <Image Width="92"
                                   Height="92"
                                   HorizontalAlignment="Center"
                                   Margin="0,-10,0,6"
                                   Source="avares://BabelPlayer/Assets/logo%20x512.png"
                                   Stretch="Uniform" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource VideoOverlayTextBrush}"
                                       Text="{local:Localize Window_Title_Main}" />
                            <TextBlock MaxWidth="300"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                       Text="{local:Localize Tooltip_OpenMedia}" />
                            <Button x:Name="VideoEmptyStateOpenButton"
                                    HorizontalAlignment="Center"
                                    Padding="16,8"
                                    Click="OnOpenMediaClick"
                                    Content="{local:Localize Automation_OpenMedia}"
                                    ToolTip.Tip="{local:Localize Tooltip_OpenMedia}"
                                    AutomationProperties.Name="{local:Localize Automation_OpenMedia}" />
                        </StackPanel>
                    </Border>
                </Border>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="10,6"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsVisible="{Binding Playback.HasVsrPlaybackStatus}">
                    <TextBlock Text="{Binding Playback.VsrPlaybackStatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource VideoOverlayTextBrush}"
                               TextWrapping="Wrap" />
                </Border>
                <Panel x:Name="VideoOverlayPanel" Background="Transparent" />

            </Grid>

            <!-- Scrub bar -->
            <Border Grid.Row="2" Grid.Column="0" Padding="12,5"
                    IsVisible="{Binding Playback.Preview.IsControlsVisible}">
                <Grid ColumnDefinitions="40,*,40">
                     <TextBlock Grid.Column="0"
                                Text="{Binding Playback.Preview.SourcePositionFormatted}"
                                FontSize="11" Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                VerticalAlignment="Center" />
                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding Playback.Preview.SourceDurationMs}"
                            Value="{Binding Playback.Preview.SourcePositionMs, Mode=TwoWay}"
                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                            VerticalAlignment="Center" />
                     <TextBlock Grid.Column="2"
                                Text="{Binding Playback.Preview.SourceDurationFormatted}"
                                FontSize="11" Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
            </Border>

            <!-- Controls bar: bottom overlay anchored to the player column -->
            <Border x:Name="ControlsBarContainer"
                    Grid.Row="3" Grid.Column="0"
                    Padding="12,7"
                    ZIndex="2"
                    IsVisible="{Binding Playback.Preview.IsControlsVisible}">
                <Border.Styles>
                    <!-- Dev toolbar pill style: amber tint so it's visually distinct -->
                    <Style Selector="Button.dev-pill">
                        <Setter Property="Foreground" Value="#D4A017" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="#3A3010" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                    <Style Selector="Button.dev-pill /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="Button.dev-pill:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#2A2010" />
                    </Style>
                    <Style Selector="Button.dev-pill:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="#38280A" />
                    </Style>
                </Border.Styles>

                <Grid>
                    <!-- Wide: left | transport | right; Bi-lang moved to Settings -->
                    <ScrollViewer x:Name="ControlsBarScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalAlignment="Stretch"
                                  IsVisible="{Binding Playback.Preview.IsWideVideoChrome}">
                        <!-- Keep star spacer columns finite inside ScrollViewer so left/center/right groups stay distributed. -->
                        <Grid x:Name="WideVideoChromeLayoutRoot"
                              ColumnDefinitions="Auto,*,Auto,*,Auto"
                              MinWidth="{Binding Viewport.Width, ElementName=ControlsBarScrollViewer}">

                            <!-- Left: open media + CC + dub mode toggle -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                <Button Classes="control-pill"
                                        Padding="10,8"
                                        FontSize="14"
                                        Background="Transparent"
                                        Click="OnOpenMediaClick"
                                        ToolTip.Tip="{local:Localize Tooltip_OpenMedia}"
                                        AutomationProperties.Name="{local:Localize Automation_OpenMedia}">
                                    <TextBlock Text="📁" FontSize="14"/>
                                </Button>
                                <Button Content="{Binding Playback.Preview.SubtitleToggleLabel}"
                                        Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleSubtitlesCommand}"
                                        IsEnabled="{Binding Playback.Preview.HasSegments}"
                                        Padding="8,6" FontSize="11"
                                        Background="Transparent"
                                        ToolTip.Tip="{local:Localize Tooltip_ToggleSubtitles}"
                                        AutomationProperties.Name="{local:Localize Automation_ToggleSubtitles}" />
                                <Button Content="{Binding Playback.Preview.DubModeLabel}"
                                        Classes="control-pill"
                                        Classes.active="{Binding Playback.Preview.IsDubModeOn}"
                                        Command="{Binding Playback.Preview.ToggleDubModeCommand}"
                                        IsEnabled="{Binding Playback.Preview.HasSegments}"
                                        Padding="8,6" FontSize="11"
                                        Background="Transparent"
                                        ToolTip.Tip="{local:Localize Tooltip_ToggleDubMode}"
                                        AutomationProperties.Name="{local:Localize Automation_ToggleDubMode}" />

                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0"
                                            IsVisible="{Binding Playback.Preview.IsDubModeOn}">
                                    <TextBlock Text="{Binding Playback.Preview.DubMixControlLabel}" FontSize="10" Foreground="#8A88A8" VerticalAlignment="Center" />
                                    <Slider Width="60"
                                            Orientation="Horizontal"
                                            Minimum="-30"
                                            Maximum="0"
                                            Value="{Binding Playback.Preview.DubMixControlDb, Mode=TwoWay}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding Playback.Preview.DubMixControlTooltip}" />
                                    <TextBlock Text="{Binding Playback.Preview.DubMixControlValueLabel}"
                                               FontSize="10"
                                               Foreground="#8A88A8"
                                               VerticalAlignment="Center"
                                               Width="30" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Center: playback buttons in a unified transport capsule -->
                            <Border Grid.Column="2" Classes="glass-rack" Padding="6,4"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Classes="control-pill"
                                            Command="{Binding Playback.Preview.SkipBackwardCommand}"
                                            IsEnabled="{Binding Playback.Preview.HasSegments}"
                                            Padding="10,6" FontSize="12"
                                            ToolTip.Tip="{local:Localize Tooltip_SkipPrevious}"
                                            AutomationProperties.Name="{local:Localize Automation_SkipPrevious}">
                                        <TextBlock Text="|◀" FontSize="12"/>
                                    </Button>
                                    <Button Classes="control-pill"
                                            Command="{Binding Playback.Preview.RewindCommand}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            Padding="10,6" FontSize="12"
                                            ToolTip.Tip="{local:Localize Tooltip_Rewind10}"
                                            AutomationProperties.Name="{local:Localize Automation_Rewind10}">
                                        <TextBlock Text="◀◀" FontSize="12"/>
                                    </Button>
                                    <Button Command="{Binding Playback.Preview.PlayPauseSourceCommand}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            Width="46" Height="46" Padding="0" Margin="4,0"
                                            CornerRadius="23" Background="{DynamicResource AccentBrush}"
                                            ToolTip.Tip="{local:Localize Tooltip_PlayPause}"
                                            AutomationProperties.Name="{local:Localize Automation_PlayPause}">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
                                            </Style>
                                        </Button.Styles>
                                        <TextBlock Text="{Binding Playback.Preview.PlayPauseSourceLabel}"
                                                   FontSize="{DynamicResource FontSizeTitle}"
                                                   FontWeight="Medium"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                    <Button Classes="control-pill"
                                            Command="{Binding Playback.Preview.FastForwardCommand}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            Padding="10,6" FontSize="12"
                                            ToolTip.Tip="{local:Localize Tooltip_Forward10}"
                                            AutomationProperties.Name="{local:Localize Automation_Forward10}">
                                        <TextBlock Text="▶▶" FontSize="12"/>
                                    </Button>
                                    <Button Classes="control-pill"
                                            Command="{Binding Playback.Preview.SkipForwardCommand}"
                                            IsEnabled="{Binding Playback.Preview.HasSegments}"
                                            Padding="10,6" FontSize="12"
                                            ToolTip.Tip="{local:Localize Tooltip_SkipNext}"
                                            AutomationProperties.Name="{local:Localize Automation_SkipNext}">
                                        <TextBlock Text="▶|" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Right: utility controls -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleMuteCommand}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="{local:Localize Tooltip_ToggleMute}"
                                        AutomationProperties.Name="{local:Localize Automation_ToggleMute}">
                                    <TextBlock Text="🔊" FontSize="12"/>
                                </Button>
                                <Slider Width="70"
                                        Orientation="Horizontal"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding Playback.Preview.SourceVolume, Mode=TwoWay}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        VerticalAlignment="Center"
                                        Margin="2,0,6,0"
                                        ToolTip.Tip="{local:Localize Tooltip_Volume}" />

                                <Button Classes="control-pill"
                                        Classes.active="{Binding Playback.Preview.IsLeftPaneVisible}"
                                        Command="{Binding Playback.Preview.ToggleLeftPaneCommand}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="{Binding Playback.Preview.LeftPaneTooltip}"
                                        AutomationProperties.Name="{local:Localize Automation_ToggleLeftPane}">
                                    <TextBlock Text="◧" FontSize="13"/>
                                </Button>

                                <Button Classes="control-pill"
                                        Classes.active="{Binding Playback.Preview.IsRightPaneVisible}"
                                        Command="{Binding Playback.Preview.ToggleRightPaneCommand}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="{Binding Playback.Preview.RightPaneTooltip}"
                                        AutomationProperties.Name="{local:Localize Automation_ToggleRightPane}">
                                    <TextBlock Text="◨" FontSize="13"/>
                                </Button>

                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleFullscreenCommand}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="{local:Localize Tooltip_ToggleFullscreen}"
                                        AutomationProperties.Name="{local:Localize Automation_ToggleFullscreen}">
                                    <TextBlock Text="⛶" FontSize="12"/>
                                </Button>

                                <Button Classes="control-pill"
                                        Click="OnSettingsClick"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="{local:Localize Tooltip_OpenSettings}"
                                        AutomationProperties.Name="{local:Localize Automation_Settings}">
                                    <TextBlock Text="⚙" FontSize="14"/>
                                </Button>

                                <Border Margin="6,0,0,0"
                                        BorderBrush="#3A3010"
                                        BorderThickness="1,0,0,0"
                                        Padding="6,0,0,0"
                                        IsVisible="{x:Static bp:BuildInfo.IsDevBuild}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="dev-pill"
                                                x:Name="DevLogButton"
                                                Content="{local:Localize Dev_Button_DevLog}"
                                                Padding="6,5" FontSize="12"
                                                ToolTip.Tip="{local:Localize Dev_Tooltip_DevLog}" />
                                        <Button Classes="dev-pill"
                                                x:Name="FreshStartButton"
                                                Content="{local:Localize Dev_Button_FreshStart}"
                                                Padding="6,5" FontSize="12"
                                                ToolTip.Tip="{local:Localize Dev_Tooltip_FreshStart}" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                        </Grid>
                    </ScrollViewer>

                    <!-- Compact: transport centered first row, media + utility controls split on row two -->
                    <StackPanel IsVisible="{Binding Playback.Preview.IsCompactVideoChrome}"
                                Spacing="6">
                        <Border Classes="glass-rack"
                                Padding="6,4"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.SkipBackwardCommand}"
                                        IsEnabled="{Binding Playback.Preview.HasSegments}"
                                        Padding="10,6" FontSize="12"
                                        ToolTip.Tip="{local:Localize Tooltip_SkipPrevious}"
                                        AutomationProperties.Name="{local:Localize Automation_SkipPrevious}">
                                    <TextBlock Text="|◀" FontSize="12"/>
                                </Button>
                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.RewindCommand}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        Padding="10,6" FontSize="12"
                                        ToolTip.Tip="{local:Localize Tooltip_Rewind10}"
                                        AutomationProperties.Name="{local:Localize Automation_Rewind10}">
                                    <TextBlock Text="◀◀" FontSize="12"/>
                                </Button>
                                <Button Command="{Binding Playback.Preview.PlayPauseSourceCommand}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        Width="46" Height="46" Padding="0" Margin="4,0"
                                        CornerRadius="23" Background="{DynamicResource AccentBrush}"
                                        ToolTip.Tip="{local:Localize Tooltip_PlayPause}"
                                        AutomationProperties.Name="{local:Localize Automation_PlayPause}">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
                                        </Style>
                                    </Button.Styles>
                                    <TextBlock Text="{Binding Playback.Preview.PlayPauseSourceLabel}"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               FontWeight="Medium"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Button>
                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.FastForwardCommand}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        Padding="10,6" FontSize="12"
                                        ToolTip.Tip="{local:Localize Tooltip_Forward10}"
                                        AutomationProperties.Name="{local:Localize Automation_Forward10}">
                                    <TextBlock Text="▶▶" FontSize="12"/>
                                </Button>
                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.SkipForwardCommand}"
                                        IsEnabled="{Binding Playback.Preview.HasSegments}"
                                        Padding="10,6" FontSize="12"
                                        ToolTip.Tip="{local:Localize Tooltip_SkipNext}"
                                        AutomationProperties.Name="{local:Localize Automation_SkipNext}">
                                    <TextBlock Text="▶|" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Left">
                                <Button Classes="control-pill"
                                        Padding="10,8"
                                        FontSize="14"
                                        Background="Transparent"
                                        Click="OnOpenMediaClick"
                                        ToolTip.Tip="{local:Localize Tooltip_OpenMedia}"
                                        AutomationProperties.Name="{local:Localize Automation_OpenMedia}">
                                    <TextBlock Text="📁" FontSize="14"/>
                                </Button>
                                <Button Content="{Binding Playback.Preview.SubtitleToggleLabel}"
                                        Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleSubtitlesCommand}"
                                        IsEnabled="{Binding Playback.Preview.HasSegments}"
                                        Padding="8,6" FontSize="11"
                                        Background="Transparent"
                                        ToolTip.Tip="{local:Localize Tooltip_ToggleSubtitles}"
                                        AutomationProperties.Name="{local:Localize Automation_ToggleSubtitles}" />
                                <Button Content="{Binding Playback.Preview.DubModeLabel}"
                                        Classes="control-pill"
                                        Classes.active="{Binding Playback.Preview.IsDubModeOn}"
                                        Command="{Binding Playback.Preview.ToggleDubModeCommand}"
                                        IsEnabled="{Binding Playback.Preview.HasSegments}"
                                        Padding="8,6" FontSize="11"
                                        Background="Transparent"
                                        ToolTip.Tip="{local:Localize Tooltip_ToggleDubMode}"
                                        AutomationProperties.Name="{local:Localize Automation_ToggleDubMode}" />

                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            VerticalAlignment="Center"
                                            Margin="6,0,0,0"
                                            IsVisible="{Binding Playback.Preview.IsDubModeOn}">
                                    <TextBlock Text="{Binding Playback.Preview.DubMixControlLabel}" FontSize="10" Foreground="#8A88A8" VerticalAlignment="Center" />
                                    <Slider Width="60"
                                            Orientation="Horizontal"
                                            Minimum="-30"
                                            Maximum="0"
                                            Value="{Binding Playback.Preview.DubMixControlDb, Mode=TwoWay}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding Playback.Preview.DubMixControlTooltip}" />
                                    <TextBlock Text="{Binding Playback.Preview.DubMixControlValueLabel}"
                                               FontSize="10"
                                               Foreground="#8A88A8"
                                               VerticalAlignment="Center"
                                               Width="30" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Right">
                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleMuteCommand}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="{local:Localize Tooltip_ToggleMute}"
                                        AutomationProperties.Name="{local:Localize Automation_ToggleMute}">
                                    <TextBlock Text="🔊" FontSize="12"/>
                                </Button>
                                <Slider Width="70"
                                        Orientation="Horizontal"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding Playback.Preview.SourceVolume, Mode=TwoWay}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        VerticalAlignment="Center"
                                        Margin="2,0,6,0"
                                        ToolTip.Tip="{local:Localize Tooltip_Volume}" />

                                <Button Classes="control-pill"
                                        Classes.active="{Binding Playback.Preview.IsLeftPaneVisible}"
                                        Command="{Binding Playback.Preview.ToggleLeftPaneCommand}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="{Binding Playback.Preview.LeftPaneTooltip}"
                                        AutomationProperties.Name="{local:Localize Automation_ToggleLeftPane}">
                                    <TextBlock Text="◧" FontSize="13"/>
                                </Button>

                                <Button Classes="control-pill"
                                        Classes.active="{Binding Playback.Preview.IsRightPaneVisible}"
                                        Command="{Binding Playback.Preview.ToggleRightPaneCommand}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="{Binding Playback.Preview.RightPaneTooltip}"
                                        AutomationProperties.Name="{local:Localize Automation_ToggleRightPane}">
                                    <TextBlock Text="◨" FontSize="13"/>
                                </Button>

                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleFullscreenCommand}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="{local:Localize Tooltip_ToggleFullscreen}"
                                        AutomationProperties.Name="{local:Localize Automation_ToggleFullscreen}">
                                    <TextBlock Text="⛶" FontSize="12"/>
                                </Button>

                                <Button Classes="control-pill"
                                        Click="OnSettingsClick"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="{local:Localize Tooltip_OpenSettings}"
                                        AutomationProperties.Name="{local:Localize Automation_Settings}">
                                    <TextBlock Text="⚙" FontSize="14"/>
                                </Button>

                                <Border Margin="6,0,0,0"
                                        BorderBrush="#3A3010"
                                        BorderThickness="1,0,0,0"
                                        Padding="6,0,0,0"
                                        IsVisible="{x:Static bp:BuildInfo.IsDevBuild}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="dev-pill"
                                                x:Name="DevLogButtonCompact"
                                                Content="{local:Localize Dev_Button_DevLog}"
                                                Padding="6,5" FontSize="12"
                                                ToolTip.Tip="{local:Localize Dev_Tooltip_DevLog}" />
                                        <Button Classes="dev-pill"
                                                x:Name="FreshStartButtonCompact"
                                                Content="{local:Localize Dev_Button_FreshStart}"
                                                Padding="6,5" FontSize="12"
                                                ToolTip.Tip="{local:Localize Dev_Tooltip_FreshStart}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

            <Border Grid.Row="1"
                    Grid.Column="3"
                    x:Name="RightPaneSplitter"
                    Classes="pane-splitter"
                    IsVisible="{Binding Playback.Preview.IsRightPaneVisible}"
                    PointerPressed="OnPaneSplitterPointerPressed"
                    PointerMoved="OnPaneSplitterPointerMoved"
                    PointerReleased="OnPaneSplitterPointerReleased"
                    PointerCaptureLost="OnPaneSplitterPointerCaptureLost">
                <Border Width="1"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource BorderBrush}"
                        Opacity="0.8" />
            </Border>

            <Border Grid.Row="1"
                    x:Name="SegmentsPaneHost"
                    Grid.Column="{Binding Playback.Preview.SegmentsPaneColumn}"
                    Width="{Binding Playback.Preview.SegmentsPaneWidth}"
                    IsVisible="{Binding Playback.Preview.IsSegmentsPaneShown}"
                    Classes="glass-rack"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="{Binding Playback.Preview.SegmentsPaneBorderThickness}"
                    Margin="{Binding Playback.Preview.SegmentsPaneMargin}"
                    ZIndex="0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <Border Grid.Row="0" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{local:Localize Section_Segments}" Classes="text-title" Foreground="#F0F0F8"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4" Padding="8,2"
                                        VerticalAlignment="Center">
                                    <TextBlock FontSize="11" Foreground="#8888A0" VerticalAlignment="Center"
                                               Text="{Binding Playback.Preview.SegmentCountLabel}" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Click="OnExportMenuButtonClick"
                                    Classes="console-button"
                                    ToolTip.Tip="{local:Localize Tooltip_ExportSegments}">
                                <TextBlock Text="{local:Localize Button_Export}" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{local:Localize Menu_Export_Srt}"
                                                  Click="OnExportToSrtClick" />
                                        <MenuItem Header="{local:Localize Menu_Export_Mp3}"
                                                  Click="OnExportToMp3Click" />
                                        <MenuItem Header="{local:Localize Menu_Export_Mp4}"
                                                  Click="OnExportToMp4Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{Binding Playback.Preview.RefreshSegmentsCommand}"
                                    Classes="console-button"
                                    ToolTip.Tip="{local:Localize Tooltip_RefreshSegments}">
                                <TextBlock Text="↻" FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>

                    <Panel Grid.Row="1">
                        <ListBox Grid.Row="1"
                                 x:Name="SegmentList"
                                 Margin="0,0,0,54"
                                 ItemsSource="{Binding Playback.Preview.Segments}"
                                 SelectedItem="{Binding Playback.Preview.SelectedSegment}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SegmentPointerOverBrush}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:WorkflowSegmentState">
                                    <Border Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,12">
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Background="{Binding SpeakerId, Converter={StaticResource SpeakerIdToColorConverter}}"
                                                            CornerRadius="999"
                                                            Padding="7,2"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding SpeakerId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="{Binding SpeakerId, Converter={StaticResource SpeakerIdToShortLabelConverter}}"
                                                                   Classes="text-micro"
                                                                   FontWeight="Medium"
                                                                   Foreground="White"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Classes="text-caption"
                                                               Foreground="{DynamicResource StatusTextBrush}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:F1}s  —  {1:F1}s">
                                                                <Binding Path="StartSeconds" />
                                                                <Binding Path="EndSeconds" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SourceText}"
                                                           Classes="text-secondary"
                                                           Foreground="{DynamicResource StatusTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding TranslatedText}"
                                                           Classes="text-emphasis"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Top"
                                                        Margin="0,4,0,0" Spacing="4">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="#22C55E"
                                                         IsVisible="{Binding HasTtsAudio}"
                                                         HorizontalAlignment="Center" />
                                                <Rectangle Width="4" Height="16"
                                                           Fill="#F59E0B"
                                                           RadiusX="2" RadiusY="2"
                                                           IsVisible="{Binding HasTranslation}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel IsVisible="{Binding !Playback.Preview.HasSegments}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="4"
                                    Margin="16">
                            <TextBlock Text="{local:Localize Message_NoSegmentsTitle}"
                                       Classes="text-title"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{local:Localize Message_NoSegmentsHint}"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Panel>

                    <Border Grid.Row="2"
                            IsVisible="{Binding Playback.Preview.HasSegments}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="14,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{local:Localize Label_RenderTiming}"
                                       Classes="text-label"
                                       Foreground="{DynamicResource StatusTextBrush}"/>

                            <ComboBox ItemsSource="{Binding Playback.DubTimingModeOptions}"
                                      SelectedItem="{Binding Playback.DubTimingMode, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      Background="{DynamicResource ControlBackgroundBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SegmentTimingModeDisplayConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="{local:Localize Hint_RenderTiming}"
                                       Classes="text-caption"
                                       Foreground="{DynamicResource StatusTextBrush}"
                                       TextWrapping="Wrap"/>

                            <StackPanel IsVisible="{Binding Inspection.IsVisible}"
                                        Spacing="6">
                                <StackPanel.Styles>
                                    <Style Selector="Button.segmentTimingButton">
                                        <Setter Property="Padding" Value="8,3"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="CornerRadius" Value="4"/>
                                        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource StatusTextBrush}"/>
                                    </Style>
                                </StackPanel.Styles>
                                <TextBlock Text="{local:Localize Label_SelectedSegment}"
                                           Classes="text-label"
                                           Foreground="{DynamicResource StatusTextBrush}"/>

                                <TextBlock Text="{Binding Inspection.TimingLabel}"
                                           Classes="text-caption"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           TextWrapping="Wrap"/>

                                <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Classes="segmentTimingButton"
                                            Margin="0,0,8,8"
                                            Content="{local:Localize Option_Inherit}"
                                            Command="{Binding Inspection.SetTimingOverrideCommand}"
                                            CommandParameter="{x:Null}"
                                            ToolTip.Tip="{local:Localize Tooltip_Inherit}"/>
                                    <Button Classes="segmentTimingButton"
                                            Margin="0,0,8,8"
                                            Content="{local:Localize Option_Off}"
                                            Command="{Binding Inspection.SetTimingOverrideCommand}"
                                            CommandParameter="{x:Static models:SegmentTimingMode.Off}"
                                            ToolTip.Tip="{local:Localize Tooltip_TimingOff}"/>
                                    <Button Classes="segmentTimingButton"
                                            Margin="0,0,8,8"
                                            Content="{local:Localize Option_Stretch}"
                                            Command="{Binding Inspection.SetTimingOverrideCommand}"
                                            CommandParameter="{x:Static models:SegmentTimingMode.Stretch}"
                                            ToolTip.Tip="{local:Localize Tooltip_TimingStretch}"/>
                                </WrapPanel>

                                <TextBlock Text="{Binding Inspection.TimingOverrideLabel}"
                                           FontSize="10"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>

</Window>

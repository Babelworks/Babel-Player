<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;Dev</Configurations>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>BabelPlayer</AssemblyName>
    <RootNamespace>Babel.Player</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredPGO>true</TieredPGO>
    <!-- Fallback for local dev builds; overridden by -p:BuildDate=... in the release workflow -->
    <BuildDate Condition="'$(BuildDate)' == ''">0000-00-00</BuildDate>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════════════
       Dev configuration — build with: dotnet run -c Dev
       Defines BABEL_DEV, disables optimisations, keeps full debug info.
       ═══════════════════════════════════════════════════════════════ -->
  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <DefineConstants>DEBUG;TRACE;BABEL_DEV</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Strongly-typed UI strings. The base Strings.resx and satellite
      Strings.{lang}.resx files are regenerated by
      scripts/build_strings_resx.py and Tools/LocaleGenerator. The
      <Generator>/<LastGenOutput> metadata is preserved for Visual Studio's
      ResXFileCodeGenerator integration, but Strings.Designer.cs is
      maintained by hand so dotnet CLI builds work without VS.
    -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
      <ManifestResourceName>Babel.Player.Resources.Strings</ManifestResourceName>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="BabelPlayer\**" />
    <Compile Remove="BabelPlayer.Tests\**" />
    <Compile Remove="Tools\**" />
    <EmbeddedResource Remove="BabelPlayer\**" />
    <EmbeddedResource Remove="Tools\**" />
    <None Remove="BabelPlayer\**" />
    <None Remove="Tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
    <!-- Override Avalonia.FreeDesktop's vulnerable transitive D-Bus dependency. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0-preview.26428.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>BabelPlayer.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Bake the build date into the assembly so BuildInfo.cs can read it at runtime -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$(BuildDate)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Staged after optional FetchWinNativeDepsIfNeeded (Directory.Build.targets) so a single build picks up freshly downloaded files. Uses $(BabelWinNativeSubdir) (win-x64 vs win-arm64) from Directory.Build.targets. -->
  <Target Name="IncludeBabelWinNativeArtifacts" BeforeTargets="AssignTargetPaths" AfterTargets="FetchWinNativeDepsIfNeeded" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\native\$(BabelWinNativeSubdir)\libmpv-2.dll')">
      <None Include="$(MSBuildProjectDirectory)\native\$(BabelWinNativeSubdir)\libmpv-2.dll">
        <Link>native\$(BabelWinNativeSubdir)\libmpv-2.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
    </ItemGroup>
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\uv.exe')">
      <None Include="$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\uv.exe">
        <Link>tools\$(BabelWinNativeSubdir)\uv.exe</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
    </ItemGroup>
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\piper\piper.exe')">
      <BabelPiperFile Include="$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\piper\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)tools\$(BabelWinNativeSubdir)\piper" Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\piper\piper.exe')" />
    <Copy SourceFiles="@(BabelPiperFile)" DestinationFiles="@(BabelPiperFile->'$(OutDir)tools\$(BabelWinNativeSubdir)\piper\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\piper\piper.exe')" />
    <MakeDir Directories="$(OutDir)tools\$(BabelWinNativeSubdir)" Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\ffmpeg.exe')&#xA;                        or Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\ffprobe.exe')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\ffmpeg.exe" DestinationFiles="$(OutDir)tools\$(BabelWinNativeSubdir)\ffmpeg.exe" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\ffmpeg.exe')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\ffprobe.exe" DestinationFiles="$(OutDir)tools\$(BabelWinNativeSubdir)\ffprobe.exe" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\ffprobe.exe')" />
  </Target>

  <Target Name="IncludeBabelWinNativeArtifactsInPublish" AfterTargets="CopyFilesToPublishDirectory" Condition="'$(OS)' == 'Windows_NT' and '$(PublishDir)' != ''">
    <MakeDir Directories="$(PublishDir)tools\$(BabelWinNativeSubdir)" Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\ffmpeg.exe')&#xA;                        or Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\ffprobe.exe')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\ffmpeg.exe" DestinationFiles="$(PublishDir)tools\$(BabelWinNativeSubdir)\ffmpeg.exe" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\ffmpeg.exe')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\ffprobe.exe" DestinationFiles="$(PublishDir)tools\$(BabelWinNativeSubdir)\ffprobe.exe" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\ffprobe.exe')" />
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\piper\piper.exe')">
      <BabelPiperFile Include="$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\piper\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)tools\$(BabelWinNativeSubdir)\piper" Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\piper\piper.exe')" />
    <Copy SourceFiles="@(BabelPiperFile)" DestinationFiles="@(BabelPiperFile->'$(PublishDir)tools\$(BabelWinNativeSubdir)\piper\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\piper\piper.exe')" />
  </Target>

<ItemGroup>
  <None Include="docker-compose.yml">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
  <None Include="inference\**\*" Exclude="inference\__pycache__\**;inference\*.pyc">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
</ItemGroup>

  <Target Name="DeletePublishedReleaseSymbols" AfterTargets="CopyFilesToPublishDirectory" Condition="'$(Configuration)' == 'Release' and '$(PublishDir)' != ''">
    <ItemGroup>
      <ReleasePublishSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(ReleasePublishSymbols)" TreatErrorsAsWarnings="true" />
  </Target>
</Project>
